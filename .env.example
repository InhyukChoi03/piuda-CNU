PIUDA_HOST=0.0.0.0
PIUDA_PORT=8080
PIUDA_TLS_CERT=/home/cnu/.local/share/piuda/tls/piuda-server.crt
PIUDA_TLS_KEY=/home/cnu/.local/share/piuda/tls/piuda-server-key.pem
PIUDA_DATA_DIR=/home/cnu/.local/share/piuda
PIUDA_TIMEZONE=Asia/Seoul
PIUDA_OLLAMA_URL=http://127.0.0.1:11434
PIUDA_OLLAMA_MODEL=hf.co/naver-ellm/HyperCLOVAX-SEED-Text-Instruct-1.5B-GGUF:Q4_K_M
PIUDA_OLLAMA_KEEP_ALIVE=24h
PIUDA_OLLAMA_TIMEOUT=20
PIUDA_DEMO_MODE=1
PIUDA_INACTIVITY_MINUTES=180
PIUDA_TASK_GRACE_MINUTES=30
PIUDA_HOTSPOT_SSID=PIUDA-CNU
PIUDA_HOTSPOT_PASSWORD=piuda3017
PIUDA_HOTSPOT_GATEWAY=192.168.4.1
PIUDA_DEMO_SENSOR_KEY=piuda-demo-3017
PIUDA_STT_BINARY=/home/cnu/.local/lib/piuda-whisper/whisper-cli
PIUDA_STT_MODEL=/home/cnu/.local/share/piuda/models/ggml-tiny.bin
PIUDA_STT_VAD_MODEL=/home/cnu/.local/share/piuda/models/ggml-silero-v6.2.0.bin
PIUDA_STT_MIC_DEVICE=plughw:CARD=Microphone,DEV=0
PIUDA_STT_DURATION_SECONDS=5
PIUDA_TTS_ROOT=/home/cnu/.local/lib/piuda-supertonic
# Supertonic 3: 0~4는 여성, 5~9는 남성 음성이며 기본 0은 차분한 F1입니다.
PIUDA_TTS_SPEAKER_ID=0
PIUDA_TTS_NUM_STEPS=8
PIUDA_TTS_SPEED=1.03

# 발표 공간에서 정지·걷기·빠른 움직임을 측정한 뒤 필요할 때 조정합니다.
PIUDA_CSI_MOTION_THRESHOLD=12
PIUDA_CSI_STRONG_THRESHOLD=45

# 선택: 카카오 나에게 보내기 API. 토큰은 절대 Git에 커밋하지 않습니다.
PIUDA_KAKAO_ACCESS_TOKEN=
